# Chiave OpenAI (obbligatoria per le risposte AI generali; il router deterministico funziona anche senza)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS: in produzione metti l'origine esatta del frontend (es. https://tuonome.github.io)
ALLOWED_ORIGIN=*

# Cloud DB proxy: le credenziali JSONBin vivono qui, MAI nell'HTML.
# Dopo averle impostate, ruota la vecchia chiave su jsonbin.io (quella nell'HTML storico è da considerare compromessa).
JSONBIN_BIN_ID=
JSONBIN_API_KEY=

# v9 — Segreto per firmare i token di accesso e le bozze AI (stringa lunga e casuale).
# Se assente, viene derivato dalle credenziali JSONBin; se manca anche quello, parte
# un secret di sviluppo NON adatto alla produzione (vedrai un warning nei log).
RV_AI_SECRET=

# v9 — Override password account base (facoltativi: di default valgono le password attuali).
# RV_USER_RURALVET_PASS=
# RV_USER_MEDARDO_PASS=
# RV_USER_EDOARDO_PASS=

# Facoltative
# PORT=3000
# OPENAI_TIMEOUT_MS=24000
# AI_DEBUG=true
# MAX_DB_BYTES=8388608
# RV_TOKEN_TTL_MS=43200000     # durata token (default 12 ore)
# KM_ANOMALY_MAX=400           # soglia km/tratta oltre cui il record è escluso e segnalato
# RV_AUTH_OPTIONAL=false       # SOLO per debug: true disattiva l'obbligo di token
