# Chiave OpenAI (obbligatoria per le risposte AI generali; il router deterministico funziona anche senza)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS: in produzione metti l'origine esatta del frontend (es. https://tuonome.github.io)
ALLOWED_ORIGIN=*

# Cloud DB proxy (v8.9): sposta qui le credenziali JSONBin, MAI nell'HTML.
# Dopo averle impostate, ruota la vecchia chiave su jsonbin.io (quella nell'HTML è da considerare compromessa).
JSONBIN_BIN_ID=
JSONBIN_API_KEY=

# Facoltative
# PORT=3000
# OPENAI_TIMEOUT_MS=24000
# AI_DEBUG=true
# MAX_DB_BYTES=8388608
